{
  "name": "projeto-automacao-certiqa",
  "version": "1.0.0",
  "description": "Projeto de testes automatizados com Cypress e Cucumber (BDD) para o CertiQA",
  "main": "cypress.config.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "test:static": "node scripts/audit-gherkin-steps.mjs",
    "test:unit": "node --test tests/regras_aprovacao.test.mjs",
    "test:smoke": "cypress run --spec cypress/e2e/features/smoke_readonly.feature",
    "test:login": "cypress run --spec cypress/e2e/features/login.feature",
    "test:cadastro": "cypress run --spec cypress/e2e/features/cadastro.feature",
    "test:fases": "cypress run --spec cypress/e2e/features/exames_fase.feature",
    "test:final": "cypress run --spec cypress/e2e/features/exame_final.feature",
    "test:all": "node scripts/run-suite.mjs",
    "check:env": "node scripts/check-env.mjs"
  },
  "keywords": [
    "cypress",
    "cucumber",
    "bdd",
    "qa",
    "certiqa"
  ],
  "author": "",
  "license": "ISC",
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.{js,ts}"
    ]
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^16.3.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
